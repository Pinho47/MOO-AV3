flowchart TD
    subgraph lanePaciente["Paciente"]
        ini([Início])
        solicitar[Solicitar agendamento]
        escolher[Selecionar horário]
        comparecer[Comparecer à sessão]
    end

    subgraph laneSistema["Sistema (aplicação e domínio)"]
        consultar[Consultar horários (OP-11)]
        d1{Há horários?}
        validar[Validar vínculo e horário]
        d2{Vínculo OK?}
        criar[Criar agendamento]
        confirmar[Confirmar (OP-13)]
        semHor[Sem horários (A1)]
        recusar[Recusar (E1)]
        d3{Cancelamento?}
        cancelar[Cancelar (OP-14)]
        manter[Manter agendamento]
        liberar[Liberar horário]
        d5{Sessão realizada?}
        falta[Registrar falta (OP-18)]
    end

    subgraph lanePsicologo["Psicólogo"]
        atender[Registrar atendimento (OP-20)]
        concluir[Concluir (OP-17)]
    end

    subgraph laneAuditoria["Auditoria e notificação"]
        aud1[Auditar confirmação (RN-009)]
        notif1[Notificar confirmação (AP-04)]
        aud2[Auditar cancelamento (RN-009)]
        notif2[Notificar cancelamento (AP-04)]
        aud3[Auditar conclusão (RN-009)]
        aud4[Auditar falta (RN-009)]
    end

    fimSem([Fim])
    fimRec([Fim])
    fimCanc([Fim])
    fimReal([Fim])
    fimFalta([Fim])
    fork1[||]
    fork2[||]
    fork3[||]
    join1[||]
    join2[||]
    join3[||]

    ini --> solicitar
    solicitar --> consultar
    consultar --> d1
    d1 -->|Não| semHor
    semHor --> fimSem
    d1 -->|Sim| escolher
    escolher --> validar
    validar --> d2
    d2 -->|Não| recusar
    recusar --> fimRec
    d2 -->|Sim| criar
    criar --> confirmar
    confirmar --> fork1
    fork1 -->|par 1| aud1
    fork1 -->|par 2| notif1
    aud1 --> join1
    notif1 --> join1
    join1 --> d3
    d3 -->|Sim| cancelar
    cancelar --> fork2
    fork2 -->|par 1| liberar
    fork2 -->|par 2| aud2
    liberar --> join2
    aud2 --> join2
    join2 --> notif2
    notif2 --> fimCanc
    d3 -->|Não| manter
    manter --> comparecer
    comparecer --> d5
    d5 -->|Sim| atender
    atender --> fork3
    fork3 -->|par 1| concluir
    fork3 -->|par 2| aud3
    concluir --> join3
    aud3 --> join3
    join3 --> fimReal
    d5 -->|Não| falta
    falta --> aud4
    aud4 --> fimFalta
